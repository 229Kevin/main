{
    "model": {
        "n_groups": [4],
        "patch_size": 7,
        "in_chans": 103,
        "num_classes": 9,
        "dims": [64],
        "depths": [1],
        "ssm_d_state": 16,
        "ssm_ratio": 2,
        "ssm_dt_rank": "auto",
        "ssm_conv": 3,
        "ssm_conv_bias": true,
        "ssm_drop_rate": 0,
        "use_gate": false,
        "mlp_ratio": 4,
        "mlp_drop_rate": 0,
        "drop_path_rate": 0.1,
        "bfs_enabled": false,
        "fusion_type": "center_cfam_residual",
        "fusion_heads": 8,

        "spatial_forward_type": "v3noz",
        "spatial_ssm_conv": 0,
        "spatial_ssm_init": "v0"
    },
    "schedule": {
        "optimizer": {
            "name": "AdamW",
            "params": {
                "lr": 0.001
            }
        },
        "lr_decay": {
            "name": "StepLR",
            "params": {
                "step_size": 30,
                "gamma": 0.9
            }
        }
    }
}
